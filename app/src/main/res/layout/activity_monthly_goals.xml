<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="← Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Spending Goals"
            android:textColor="#1E3A5F"
            android:textSize="26sp"
            android:textStyle="bold" />


        <EditText
            android:id="@+id/edtMinGoal"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:hint="Minimum monthly spending goal"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtMaxGoal"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Maximum monthly spending goal"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSaveMonthlyGoals"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2E7D32"
            android:text="Save Monthly Goals"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txtGoalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="18dp"
            android:text="Set your monthly minimum and maximum goals."
            android:textColor="#263238"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>