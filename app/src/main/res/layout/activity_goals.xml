<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Savings Goals"
        android:textColor="#1E3A5F"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="← Back to Home" />

    <EditText
        android:id="@+id/edtGoalName"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:hint="Goal name e.g. New Laptop"
        android:inputType="text"
        android:padding="12dp" />

    <EditText
        android:id="@+id/edtTargetAmount"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:hint="Target amount"
        android:inputType="numberDecimal"
        android:padding="12dp" />

    <EditText
        android:id="@+id/edtCurrentAmount"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:hint="Current saved amount"
        android:inputType="numberDecimal"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnAddGoal"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2E7D32"
        android:text="Add Savings Goal"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txtGoalsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="No goals added yet"
        android:textColor="#263238"
        android:textSize="16sp" />

</LinearLayout>