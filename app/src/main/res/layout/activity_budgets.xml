<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Budget Envelopes"
        android:textColor="#1E3A5F"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="← Back to Home" />

    <EditText
        android:id="@+id/edtBudgetName"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:hint="Category name e.g. Food"
        android:inputType="text"
        android:padding="12dp" />

    <EditText
        android:id="@+id/edtBudgetAmount"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:hint="Budget amount"
        android:inputType="numberDecimal"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnAddBudget"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2E7D32"
        android:text="Add Budget Envelope"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txtBudgetsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="No budgets added yet"
        android:textColor="#263238"
        android:textSize="16sp" />

</LinearLayout>